    you need?"}},{"statement":{"_text":"Whats on you''re mind?"}}],"_UID":"15b73a6d-a4a6-4ce8-ad2d-e111c58e58b1","_position":{"x":-1346.269,"y":2132.971},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"10"},{"statement":{"_text":"Oh
    thanks for asking! Right now nothing.\n\r\n"},"_UID":"ef524d7c-6a71-4cb1-9ff9-c579291dbbf0","_name":"Favor","_tag":"","_position":{"x":-1488.443,"y":2416.332},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"11"},{"_sourceNodeUID":"a8817f5b-45f2-4f1e-b10e-c25574953026","_UID":"4769a924-43a1-485e-a9a0-5061b5a94688","_position":{"x":-1467.614,"y":2499.185},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"12"},{"_sourceNodeUID":"cd7b71a5-73cc-4fdd-8854-f9ec2f7bf047","_UID":"8648dafa-3821-4893-a969-89b46ae027e4","_position":{"x":-1166.248,"y":2437.414},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"13"},{"statement":{"_text":"How''s
    your day going?"},"_UID":"f3ef85a1-e0d9-47c1-a4d7-cab0f65e6b9a","_position":{"x":-886.2868,"y":1124.12},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"14"},{"availableChoices":[{"statement":{"_text":"Good,
    how about you?"}},{"statement":{"_text":"Not Great, im worried."}}],"_UID":"25406dff-f2e7-45ca-8874-e18bc03d1e95","_position":{"x":-888.4399,"y":1576.326},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"15"},{"statement":{"_text":"Doing
    well, I was just was at the  [RandLocExcludeHotel]. Its good to get out sometimes."},"_UID":"6f778fb3-0dda-477b-afb5-2733a5d456fb","_name":"Introspection","_tag":"","_position":{"x":-1045.344,"y":1817.245},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"16"},{"statement":{"_text":"Speaking
    of places in this town-"},"_UID":"b2c8921c-b8fb-4f68-affa-214f14f14d93","_position":{"x":-1039.972,"y":1901.935},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"17"},{"_sourceNodeUID":"b1bd7d61-9466-425a-b202-6be445a088fb","_UID":"61c921a3-1321-4527-8fd5-50b4f4384776","_position":{"x":-1041.431,"y":1987.947},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"18"},{"statement":{"_text":"Oh
    im sure it can''t be that bad."},"_UID":"c7bda765-a190-49a8-9446-fafeb4ab5a6b","_name":"Info","_tag":"","_position":{"x":-796.433,"y":1809.859},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"19"},{"statement":{"_text":"At
    least not as bad as that wacko that escaped jail after murder! Must''ve been
    the work of the devil"},"_UID":"6b791bfd-6c57-4bdb-95eb-bb1935a2ab6d","_position":{"x":-798.6388,"y":1891.327},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"20"},{"statement":{"_text":"He
    does''t even speek, just steals everyone''s stuff. "},"_UID":"37b41f53-fc11-48e6-aa9a-bc70c745d6ae","_position":{"x":-790.778,"y":1969.028},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"21"},{"statement":{"_text":"Mabye
    you can give him something and he''ll say something actually usefull."},"_UID":"60fddec9-ed26-4723-be9e-b62a060076f7","_position":{"x":-797.7163,"y":2040.473},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"22"},{"statement":{"_text":"The
    places in this town are wonderfull to visit."},"_UID":"aa3c65b5-afaa-4372-86e4-f5c73cdb5260","_position":{"x":-457.0433,"y":1114.348},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"23"},{"availableChoices":[{"statement":{"_text":"What
    makes it so great?"}},{"statement":{"_text":"Do you have a place in particular
    you visit?"}},{"statement":{"_text":"Whats on your mind?"}}],"_UID":"330ff1d1-89fe-461e-a0c0-6eaaa232ab3d","_position":{"x":-530.2765,"y":2783.592},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"24"},{"statement":{"_text":"Well
    my friend [randPersonName] and I love the shops here."},"_UID":"eab20001-2bde-4712-aa9e-0ee6b90a5f61","_name":"Info","_tag":"","_position":{"x":-936.5007,"y":3021.531},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"25"},{"statement":{"_text":"That
    reminds me, We saw that photographer recently while at the shop across the road."},"_UID":"60aaa9c0-2e0b-4da2-9665-085707878bc2","_position":{"x":-940.1676,"y":3108.984},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"26"},{"statement":{"_text":"You
    should ask her to take photos of places to know whats going on around town."},"_UID":"2e189761-7c58-4b77-9387-3bb05a99ed37","_position":{"x":-933.5005,"y":3188.433},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"27"},{"statement":{"_text":"She
    usually has a place in mind though, You''d have to talk to her first to see where
    she wants to take photos/"},"_position":{"x":-931.0,"y":3277.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"28"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"ccd05ec1-0005-43c0-90bc-99f9c6e8fef9","_tag":"","_position":{"x":-434.1534,"y":3023.624},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"29"},{"statement":{"_text":"Yeah,
    the [RandLocExcludeHotel], its one of my favorites."},"_UID":"93463539-d4de-4f61-a434-d17f96a732d9","_name":"Grouping","_tag":"","_position":{"x":-618.5574,"y":3107.782},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"30"},{"statement":{"_text":"I
    go there all the time with my friend [personITalkAboutsName]."},"_UID":"cdbbade5-fbae-4fb1-9fc1-7bc982a9edc0","_position":{"x":-615.0564,"y":3177.656},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"31"},{"statement":{"_text":"You
    know they can be very [personITalkAboutsGroupingTrait] sometimes."},"_UID":"3243edd8-793d-4b36-b6fb-ecde02daafe7","_position":{"x":-615.0775,"y":3250.5},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"32"},{"statement":{"_text":"I
    love visiting [RandLocExcludeHotel]. You should come with me sometimes."},"_UID":"520f6535-b27a-427e-a98e-969d76024ba7","_name":"Favor","_tag":"","_position":{"x":-378.3628,"y":3111.209},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"33"},{"availableChoices":[{"statement":{"_text":"Sure
    I would love to"}},{"statement":{"_text":"I can''t really anytime soon"}}],"_UID":"d2a2b0cd-05e6-4eca-97e1-26ef32c207ed","_position":{"x":-370.5442,"y":3179.435},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"34"},{"statement":{"_text":"Great,
    I''ll keep my schedule open then."},"_UID":"52ed5357-d218-48d3-83ce-a78d097e0a60","_position":{"x":-365.3575,"y":3307.571},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"35"},{"_sourceNodeUID":"a8817f5b-45f2-4f1e-b10e-c25574953026","_UID":"e4071a73-b6e7-4d68-928b-b13245bb0074","_position":{"x":-355.304,"y":3388.452},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"36"},{"statement":{"_text":"Aw,
    well what are you doing gettin my hopes up for!"},"_UID":"6296d3ba-8558-4f0c-83e8-56f9a7792c3f","_position":{"x":-151.4139,"y":3311.811},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"37"},{"_sourceNodeUID":"5b60f0a3-08f4-4b76-b228-0e4f2cdf9449","_UID":"29782df9-40e8-4c99-a0ac-08e97a8de107","_position":{"x":-138.832,"y":3384.566},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"38"},{"_sourceNodeUID":"cd7b71a5-73cc-4fdd-8854-f9ec2f7bf047","_UID":"2fd16fae-cab6-467c-b1ac-3464fa7a041f","_position":{"x":-77.0464,"y":3013.042},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"39"},{"statement":{"_text":"I
    was at the [RandLoc] earlier, it seems different."},"_UID":"0826dd7b-1f1b-4e86-806e-f2d7eda88df4","_position":{"x":-18.89038,"y":1119.262},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"40"},{"availableChoices":[{"statement":{"_text":"Different
    in what way?"}},{"statement":{"_text":"Best not to go there anymore I suppose"}},{"statement":{"_text":"What
    else has been on your mind?"}}],"_UID":"99cf044b-a50c-42f8-b0f9-580189010196","_position":{"x":-79.42864,"y":1541.968},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"41"},{"statement":{"_text":"Mabye
    it was that creepy lady who dresses in all black."},"_UID":"3f85bece-83c4-4bab-93c9-be97ca5a1046","_name":"Info","_tag":"","_position":{"x":-212.6286,"y":1757.602},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"42"},{"statement":{"_text":"If
    you talk to her I''d be weary... She knows some things."},"_UID":"c1cd6abd-27fe-4654-a087-ce15afe723c0","_position":{"x":-208.7109,"y":1833.667},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"43"},{"statement":{"_text":"Ah
    but I loved how it felt before, Well thanks anyway."},"_UID":"640a1194-f136-4175-8524-7efbe0f17b69","_tag":"Introspection","_position":{"x":32.27484,"y":1758.67},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"44"},{"statement":{"_text":"That
    reminds me-"},"_UID":"9444d6d2-0956-4084-a45f-c1f1186e7300","_position":{"x":39.86572,"y":1829.794},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"45"},{"_sourceNodeUID":"b1bd7d61-9466-425a-b202-6be445a088fb","_UID":"5e78c999-d891-45c0-bae3-5f696e04ff46","_position":{"x":51.95332,"y":1905.794},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"46"},{"_sourceNodeUID":"cd7b71a5-73cc-4fdd-8854-f9ec2f7bf047","_UID":"77f75ec7-581e-416d-955b-81f3b6654dcb","_position":{"x":258.4959,"y":1908.335},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"47"},{"statement":{"_text":"I
    heard some people talking about the [RandLoc] earlier. Wonder what that was about? 
    \r\n"},"_UID":"0b27a12d-e54f-4553-ab57-98f356420729","_position":{"x":289.5461,"y":1133.477},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"48"},{"availableChoices":[{"statement":{"_text":"Do
    you know who?"}},{"statement":{"_text":"What was discussed?"}},{"statement":{"_text":"Whats
    on your mind?"}}],"_UID":"ad101201-9148-46b6-bde2-8de9ca9e7b24","_position":{"x":326.0762,"y":2156.874},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"49"},{"statement":{"_text":"Hmm..
    I think it was [randPersonName]?"},"_UID":"d20e8347-4e62-4975-aac9-12de358a0ca6","_name":"Info","_tag":"","_position":{"x":207.6643,"y":2412.744},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"50"},{"statement":{"_text":"I''m
    not sure..."},"_UID":"dceefedf-3dbc-45de-b604-0ad1a6d71670","_position":{"x":207.7064,"y":2488.189},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"51"},{"statement":{"_text":"People
    talk crazy here all the time, its like there''s something evil here"},"_UID":"e4f8ce26-ac5a-487a-8f62-46ebc5ef1381","_position":{"x":211.4963,"y":2567.736},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"52"},{"statement":{"_text":"Or
    someone."},"_UID":"1db4f849-0fb0-45c5-b1e8-1d068d588b6d","_position":{"x":217.1884,"y":2643.556},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"53"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"c40de3ca-66a2-4705-9712-e0b17bbb9950","_name":"Introspection","_tag":"","_position":{"x":520.3388,"y":2405.474},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"54"},{"statement":{"_text":"Hmm.."},"_UID":"04f4beba-9b95-4010-b67b-dba901f2c63e","_position":{"x":604.8962,"y":2690.485},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"55"},{"statement":{"_text":"I
    forgot."},"_UID":"53b8488f-f589-490b-8e08-7915ed9f242b","_position":{"x":597.7202,"y":2769.241},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"56"},{"statement":{"_text":"Hah,
    I must be too tired to think!"},"_UID":"75577ba2-e60b-4655-9388-9357c8ea87f6","_position":{"x":488.5962,"y":2850.534},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"57"},{"_sourceNodeUID":"c46094f9-a69d-46b2-8ebe-c3687eaa1314","_UID":"3d75a18f-d0f0-4a37-ba0a-d188e59d05a6","_position":{"x":505.5962,"y":2928.535},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"58"},{"statement":{"_text":"That
    some people can be quite musically inclined"},"_UID":"7f9899cc-35b5-452e-976e-ef1de77f541a","_position":{"x":728.6193,"y":2834.43},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"59"},{"_sourceNodeUID":"020ea340-67e1-4365-8ee1-f2e1b6f265d5","_UID":"4f1392e0-22d8-4a4b-bc50-befddacbb35a","_position":{"x":721.3942,"y":2921.959},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"60"},{"statement":{"_text":"About
    the recent weather"},"_UID":"f94a4cd7-c24d-4b68-89bd-49ccdb6fdcda","_position":{"x":978.8772,"y":2828.878},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"61"},{"_sourceNodeUID":"261fad8e-454e-4a5e-aea0-d139b9ad77ff","_UID":"572d2064-945d-4b15-9cc9-724153070454","_position":{"x":979.5962,"y":2920.535},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"62"},{"statement":{"_text":"Oh
    nothing, just that-"},"_UID":"f2a45869-c125-48a5-8609-ccdb94cf5182","_position":{"x":1195.103,"y":2829.076},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"63"},{"_sourceNodeUID":"cd80251c-9532-4519-b2f2-5254f44e2b55","_UID":"99e7837b-b505-486d-8031-244e49d88dd3","_position":{"x":1202.596,"y":2926.536},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"64"},{"_sourceNodeUID":"cd7b71a5-73cc-4fdd-8854-f9ec2f7bf047","_UID":"808a366a-a5f0-4f86-a181-e601f1a97f96","_position":{"x":715.2347,"y":2359.667},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"65"},{"statement":{"_text":"I
    have to tell you what a lovely time me and [randPersonName] had last week at
    the [RandLocExcludeHotel]."},"_UID":"7970cbff-5713-4e4a-b659-893f031c71a6","_position":{"x":709.4272,"y":1140.328},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"66"},{"availableChoices":[{"statement":{"_text":"Mabye
    next time I can join."}},{"statement":{"_text":"What did you guys do?"}}],"_UID":"ecdf1289-8dc8-44c7-b0a9-a2e9dd47da4e","_position":{"x":731.7343,"y":1554.949},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"67"},{"statement":{"_text":"Sure
    we would love to have you there."},"_UID":"97681633-54da-4f9c-b0c5-6f12aa18ca2f","_position":{"x":626.4962,"y":1720.649},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"68"},{"statement":{"_text":"Speaking
    of places here-"},"_UID":"6deb6aa9-f8bb-49fb-8675-d30555b414a6","_position":{"x":630.2321,"y":1798.252},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"69"},{"_sourceNodeUID":"b1bd7d61-9466-425a-b202-6be445a088fb","_UID":"0e6c8702-161b-4f34-80a0-9b8c37628542","_position":{"x":637.7922,"y":1874.739},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"70"},{"statement":{"_text":"We
    used a little bit of that devils lettuce!"},"_UID":"c21888e3-0783-40fc-b90a-7a6f8e180736","_position":{"x":856.2522,"y":1716.712},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"71"},{"statement":{"_text":"They
    said some funny stuff when they were rambling. "},"_UID":"ad1dfe5b-3f5f-4b35-8c7d-e378b03a70bd","_position":{"x":863.9242,"y":1788.045},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"72"},{"statement":{"_text":"For
    instance-"},"_UID":"1dcc6448-821c-423a-a64e-23a39e650ddc","_position":{"x":871.8142,"y":1857.449},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"73"},{"_sourceNodeUID":"cd80251c-9532-4519-b2f2-5254f44e2b55","_UID":"2537615e-9e22-40ca-beca-aadd40ca459f","_position":{"x":884.5092,"y":1941.425},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"74"},{"statement":{"_text":"Whats
    up?  \r\n"},"_UID":"cdc15dd5-0ae2-4e19-8dde-257558cc8933","_position":{"x":1351.789,"y":1111.872},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"75"},{"availableChoices":[{"statement":{"_text":"Nothing
    much"}},{"statement":{"_text":"Alot I suppose."}},{"statement":{"_text":"Whats
    on your mind?"}}],"_UID":"04ae4376-7176-4005-83db-3022514de266","_position":{"x":1339.807,"y":1542.808},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"76"},{"statement":{"_text":"Well
    then hold on to your secrets mister."},"_UID":"0fce73c4-d6c7-4c19-9016-38210399b54a","_tag":"Info","_position":{"x":1191.392,"y":1754.75},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"77"},{"statement":{"_text":"Seems
    like everyone here has some secrets..."},"_UID":"085e0056-a6c9-453b-9529-2501bf977211","_position":{"x":1187.126,"y":1843.206},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"78"},{"statement":{"_text":"For
    instance, did you know that [personITalkAboutsName] is quite [personITalkAboutsGroupingTrait]?"},"_UID":"577b3562-3027-4e77-9a54-e4e104a4609f","_position":{"x":1192.991,"y":1922.439},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"79"},{"statement":{"_text":"Same
    here, I''ve been worried about [randPersonName] lately."},"_UID":"df76d0c5-37ac-4859-8cad-b5e05208323e","_position":{"x":1424.378,"y":1768.204},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"80"},{"statement":{"_text":"Its
    been keepin me up all night."},"_UID":"30b78968-aca9-4d28-98a5-7b09da91e4da","_position":{"x":1436.169,"y":1845.366},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"81"},{"_sourceNodeUID":"c46094f9-a69d-46b2-8ebe-c3687eaa1314","_UID":"1d506c76-9e98-4e18-8d5f-3a9a5cd4fd39","_position":{"x":1453.331,"y":1921.124},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"82"},{"_sourceNodeUID":"cd7b71a5-73cc-4fdd-8854-f9ec2f7bf047","_UID":"c2fa246a-ef86-42f7-b1ec-51d543ee9ff1","_position":{"x":1710.105,"y":1787.415},"$type":"NodeCanvas.DialogueTrees.Jumper","$id":"83"},{"statement":{"_text":"Hello"},"_UID":"aa02802f-6808-406f-a13a-a2f68655079b","_position":{"x":1532.265,"y":1112.553},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"84"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"d20e22b4-cce6-4d93-9143-8ec893387c30","_name":"INTROSPECTION","_tag":"","_position":{"x":2034.898,"y":-119.8117},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"85"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"b1bd7d61-9466-425a-b202-6be445a088fb","_tag":"Introspection:
    Location","_position":{"x":1967.503,"y":-632.6386},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"86"},{"statement":{"_text":"I
    love having the bread at the bakery."},"_UID":"208048df-ca01-43ff-aad0-a1c24d6dfee6","_position":{"x":1677.893,"y":-563.964},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"87"},{"statement":{"_text":"The
    forest looks pretty from my window."},"_UID":"461e0f33-9377-4705-90e8-0b382a2aebc7","_position":{"x":1679.57,"y":-646.2971},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"88"},{"statement":{"_text":"Do
    you think the library has any new books in?"},"_UID":"ef9098bb-5d8e-4ee2-8c3d-554d06f6e482","_position":{"x":1681.807,"y":-474.5469},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"89"},{"statement":{"_text":"When
    the wind blows just right, you can smell the farm from here."},"_UID":"be4c60e4-b9aa-467c-ada7-39b216077a60","_position":{"x":1904.578,"y":-475.8956},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"90"},{"statement":{"_text":"The
    trail is quiet, good for a long walk"},"_UID":"e8031e51-65d3-4397-af97-50ec66e302e9","_position":{"x":2130.094,"y":-474.9334},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"91"},{"statement":{"_text":"Have
    you been in the forest? I have. Spooky."},"_UID":"22c3cfda-befa-447c-8473-9f039ad045d7","_position":{"x":2135.644,"y":-557.5612},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"92"},{"statement":{"_text":"Recently,
    I heard the forest''s whispers."},"_UID":"b75cab71-058c-4787-bada-4fd2aded5514","_position":{"x":2144.74,"y":-645.535},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"93"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"261fad8e-454e-4a5e-aea0-d139b9ad77ff","_tag":"Introspection:
    Rain","_position":{"x":2197.886,"y":151.4912},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"94"},{"statement":{"_text":"Can''t
    stand the rain man. Gets all over my stuff."},"_UID":"27c1cb80-fe21-4b2a-8ba4-7c90cb4018fd","_position":{"x":1649.623,"y":311.8118},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"95"},{"statement":{"_text":"I
    wonder when it''s going to rain."},"_UID":"13e0f2ae-5a0d-41de-bd51-ff2d3f783eaf","_position":{"x":1882.157,"y":312.2584},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"96"},{"statement":{"_text":"Rain
    rain go away, come again another day!"},"_UID":"a9b8f373-fe78-4f86-a2eb-a430cf9dab0f","_position":{"x":2110.829,"y":306.4839},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"97"},{"statement":{"_text":"Sometimes
    it gets too cold"},"_UID":"a54dc8f1-568e-4c05-9f70-9a37afaef72e","_position":{"x":2352.0,"y":307.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"98"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"c46094f9-a69d-46b2-8ebe-c3687eaa1314","_tag":"Introspection:
    Sleep","_position":{"x":2741.886,"y":-912.5088},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"99"},{"statement":{"_text":"Sometimes
    I keep my curtains closed, So I can stay in bed a little later"},"_UID":"d0b4cd4e-7d26-40bc-916d-1b28ec09d5e2","_position":{"x":2537.905,"y":-720.1143},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"100"},{"statement":{"_text":"I''ve
    been suuuuper tired lately"},"_UID":"c68aae79-1a48-4e45-b85e-edbe5d0870ab","_position":{"x":2766.157,"y":-719.9447},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"101"},{"statement":{"_text":"Coffee
    makes my brain fuzzy."},"_UID":"a7d751d0-a846-45ac-b66e-bfb56c0ded68","_position":{"x":2974.989,"y":-720.7212},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"102"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"020ea340-67e1-4365-8ee1-f2e1b6f265d5","_tag":"Introspection:
    Sing & Dance","_position":{"x":2773.886,"y":182.4912},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"103"},{"statement":{"_text":"Can
    you whistle? I can, a little melody for you.."},"_UID":"6270f60b-5d2a-43ec-8ad1-556c22772ebc","_position":{"x":2994.207,"y":42.20471},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"104"},{"statement":{"_text":"Singing
    and dancing is a fun pass time."},"_UID":"79ba261c-0d50-4813-a4ec-b237327e43a7","_position":{"x":2994.841,"y":125.496},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"105"},{"statement":{"_text":"Have
    you heard the song \"Bridge over troubled water\"?"},"_UID":"07132ff6-c149-4d34-8fbf-3f941a051d5c","_position":{"x":2997.634,"y":203.7662},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"106"},{"statement":{"_text":"There
    are some fancy dancers in the town!"},"_UID":"c3d4519d-2feb-4801-9a39-b8d0c27dbc0c","_position":{"x":2996.781,"y":287.8097},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"107"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"cd80251c-9532-4519-b2f2-5254f44e2b55","_tag":"Introspection:
    Other","_position":{"x":2783.886,"y":-459.5088},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"108"},{"statement":{"_text":"Sometimes
    I think I heard someone say something, but I know for sure noones there."},"_UID":"0a7cc229-2d6e-4227-ac3d-2e5b3c7d6cb2","_position":{"x":2980.616,"y":-523.5287},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"109"},{"statement":{"_text":"I
    need me some more money"},"_UID":"96a8789f-2a3c-4a20-a50c-1394b593dcd1","_position":{"x":2981.344,"y":-598.2199},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"110"},{"statement":{"_text":"The
    traffic has been quite good lately."},"_UID":"af1fc820-b94d-4c97-b270-ab9262435961","_position":{"x":2987.233,"y":-236.5223},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"111"},{"statement":{"_text":"I
    never break the law. Im a good person I swear."},"_UID":"623f0ff5-3015-42f6-8a39-c987558ac9e1","_position":{"x":2988.287,"y":-308.4918},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"112"},{"statement":{"_text":"[randPersonName]
    scares me."},"_UID":"af4b1b99-23f8-4a9a-a287-a70fd540b1b6","_position":{"x":2982.201,"y":-455.4962},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"113"},{"statement":{"_text":"The
    government is putting chemicals in our food..."},"_UID":"3421984e-0ac6-418f-8dbe-d5795638544e","_position":{"x":2983.734,"y":-378.7939},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"114"},{"statement":{"_text":"My
    pet cat died. Sad day for me"},"_UID":"7d4636a2-3f1f-449b-9ef4-6c6896c76887","_position":{"x":2988.154,"y":-160.843},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"115"},{"statement":{"_text":"(Gained
    Minor Favor)"},"_UID":"a8817f5b-45f2-4f1e-b10e-c25574953026","_tag":"Gain Minor
    Favor","_position":{"x":-677.5238,"y":-205.9595},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"116"},{"_action":{"method":{"_baseInfo":"Dialuage|GainMinorFavor|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"},"_UID":"77680b23-84b7-42e9-9e2e-b0d981c43560","_position":{"x":-672.6359,"y":-106.9592},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"117"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"697d0993-31c5-4684-9b7a-0d8003cb55bf","_position":{"x":-1887.096,"y":2216.382},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"118"},{"statement":{"_text":"Been
    a hard day so far."},"_UID":"c1b9e685-3fb5-45dc-b777-6acb2ac2250e","_position":{"x":-1934.375,"y":2398.148},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"119"},{"statement":{"_text":"Im
    good thanks for asking!\r\n"},"_UID":"9317bd40-e2ef-41d7-b678-ddad426335a3","_position":{"x":-1938.766,"y":2319.513},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"120"},{"statement":{"_text":"Im
    alright, just need to catch some more shut eye"},"_UID":"f9bfb349-93ed-4725-aded-5ce34b1570ec","_position":{"x":-1933.429,"y":2464.187},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"121"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"6884adca-e57d-41db-9e4b-7316a02a26be","_position":{"x":-2016.096,"y":2212.761},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"122"},{"statement":{"_text":"Not
    really. Sure is a nice place to stay at though.\r\n\r"},"_UID":"02848829-c83d-4702-a538-4bc60d54007d","_position":{"x":-2226.142,"y":2302.031},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"123"},{"statement":{"_text":"Yeah,
    I think we need more water dispensers"},"_UID":"3917e1d2-d1df-424d-aa6a-15266108dd41","_position":{"x":-2230.343,"y":2373.447},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"124"},{"statement":{"_text":"Keep
    those prices down! I can barely afford my expenses right now"},"_UID":"a81db849-a241-4788-9256-eca7f3479eee","_position":{"x":-2224.042,"y":2449.272},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"125"},{"statement":{"_text":"(Gained
    Major Favor)"},"_UID":"40327d8b-68f2-4354-8ec5-9c2913c7354e","_name":"","_tag":"Gain
    Major Favor","_position":{"x":-402.5286,"y":-209.6718},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"126"},{"_action":{"method":{"_baseInfo":"Dialuage|GainMajorFavor|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"},"_UID":"5bad782e-c32e-4287-9415-fdb85f778278","_position":{"x":-397.6407,"y":-110.6715},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"127"},{"statement":{"_text":"(Lost
    Minor Favor)"},"_UID":"5b60f0a3-08f4-4b76-b228-0e4f2cdf9449","_tag":"Lost Minor
    Favor","_position":{"x":-118.8461,"y":-204.0563},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"128"},{"_action":{"method":{"_baseInfo":"Dialuage|LoseMinorFavor|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"},"_UID":"17bc70ec-9baf-4d27-8aec-ae00a4d7b68b","_position":{"x":-125.9582,"y":-107.0562},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"129"},{"statement":{"_text":"(Lost
    Major Favor)"},"_UID":"645eea84-8a48-4326-ab4a-95676be01d55","_tag":"Lost Major
    Favor","_position":{"x":142.1541,"y":-204.0563},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"130"},{"_action":{"method":{"_baseInfo":"Dialuage|LoseMajorFavor|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"},"_UID":"7b31ca50-4016-4a02-b5cc-751bd0915d60","_position":{"x":137.0419,"y":-106.0562},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"131"},{"conditions":[{"valueA":{"_type":"System.Enum","_name":"myGroupingTrait","_targetVariableID":"6921b1fe-e939-424a-ae9d-4f8f40a16088"},"valueB":{"_type":"SO_Person+GroupingTrait","_value":{"$content":1,"$type":"SO_Person+GroupingTrait"}},"$type":"NodeCanvas.Tasks.Conditions.CheckEnum"},{"valueA":{"_type":"System.Enum","_name":"myGroupingTrait","_targetVariableID":"6921b1fe-e939-424a-ae9d-4f8f40a16088"},"valueB":{"_type":"SO_Person+GroupingTrait","_value":{"$content":2,"$type":"SO_Person+GroupingTrait"}},"$type":"NodeCanvas.Tasks.Conditions.CheckEnum"},{"valueA":{"_type":"System.Enum","_name":"myGroupingTrait","_targetVariableID":"6921b1fe-e939-424a-ae9d-4f8f40a16088"},"valueB":{"_type":"SO_Person+GroupingTrait","_value":{"$content":3,"$type":"SO_Person+GroupingTrait"}},"$type":"NodeCanvas.Tasks.Conditions.CheckEnum"},{"valueA":{"_type":"System.Enum","_name":"myGroupingTrait","_targetVariableID":"6921b1fe-e939-424a-ae9d-4f8f40a16088"},"valueB":{"_type":"SO_Person+GroupingTrait","_value":{"$content":4,"$type":"SO_Person+GroupingTrait"}},"$type":"NodeCanvas.Tasks.Conditions.CheckEnum"}],"_UID":"cd7b71a5-73cc-4fdd-8854-f9ec2f7bf047","_tag":"GroupingTrait","_position":{"x":3107.721,"y":1331.807},"$type":"NodeCanvas.DialogueTrees.MultipleConditionNode","$id":"132"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"1ad6a526-1299-4f21-9f50-9628467c29d4","_tag":"Anxious","_position":{"x":2735.849,"y":1602.2},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"133"},{"statement":{"_text":"I
    recently started taking medications to calm my anxiety"},"_UID":"29179477-bd39-41e7-846a-60ad25cd8bff","_position":{"x":2527.2,"y":1686.592},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"134"},{"statement":{"_text":"I
    got real bad anxiety, although I can''t do much about it besides take medication."},"_UID":"d0be6416-56a4-4e5c-99b8-b0b4e25d8eb2","_position":{"x":2536.745,"y":1778.401},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"135"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"2ebbad7a-715d-45ef-969f-0381b3d40b43","_name":"","_tag":"Hopefull","_position":{"x":2961.816,"y":1652.846},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"136"},{"statement":{"_text":"I
    like to hope that tomorrow holds something special, even if today doesnt\r\n"},"_UID":"d2fc2cab-0d17-4d78-ac36-cc3e2c5e2d03","_position":{"x":2809.865,"y":1751.359},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"137"},{"statement":{"_text":"Whenver
    I''m down, I always try to give myself some hope.\r\n"},"_UID":"e74335cf-189f-4a1f-8a9b-34a250ec09ec","_position":{"x":2810.864,"y":1828.395},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"138"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"1ee90026-223b-425e-9082-c70f75cca4a4","_tag":"Nervous","_position":{"x":3247.816,"y":1652.846},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"139"},{"statement":{"_text":"I
    get nervous sleeping at night. Like something bad is going to happen\r\n"},"_UID":"a3e835cd-576f-44fd-bac8-1193025b041a","_position":{"x":3105.981,"y":1840.399},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"140"},{"statement":{"_text":"I''ve
    always been nervous, my hands shake when I get scared\r\n"},"_UID":"214d8f8d-e054-4ed2-8f1a-510efa899103","_position":{"x":3105.979,"y":1747.361},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"141"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_UID":"a1440d90-bf73-4334-82be-71995e1e8cf0","_tag":"Morbid","_position":{"x":3545.816,"y":1604.846},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"142"},{"statement":{"_text":"My
    friends say I have a morbid sense of humor. I made jokes about their dead dog
    and they got mad at me. Sorry! [personITalkAboutsName]\r\n"},"_UID":"5a4d8343-55e1-4067-bf73-04feffb6f28f","_position":{"x":3413.106,"y":1799.395},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"143"},{"statement":{"_text":"Sometimes
    when my family members die, I dont feel anything. Isnt that morbid?\r\n"},"_UID":"8b3589a6-db55-43b6-b1e1-e21ab54ecfc5","_position":{"x":3413.101,"y":1704.36},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"144"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"85"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"4"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"9"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"14"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"23"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"40"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"48"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"66"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"75"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"84"},"$type":"NodeCanvas.DialogueTree