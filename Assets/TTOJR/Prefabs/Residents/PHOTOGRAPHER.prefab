valueA":{"_type":"System.Enum","_name":"locationIWantToPhotograph","_targetVariableID":"4538c429-78e4-43b9-a576-1298fa1bea35"},"valueB":{"_type":"LocationRandomizer+Locations","_value":{"$content":6,"$type":"LocationRandomizer+Locations"}},"$type":"NodeCanvas.Tasks.Conditions.CheckEnum"},{"valueA":{"_type":"System.Enum","_name":"locationIWantToPhotograph","_targetVariableID":"4538c429-78e4-43b9-a576-1298fa1bea35"},"valueB":{"_type":"LocationRandomizer+Locations","_value":{"$content":7,"$type":"LocationRandomizer+Locations"}},"$type":"NodeCanvas.Tasks.Conditions.CheckEnum"}],"_UID":"bfab939c-84c6-42f0-85ea-14bc661adf38","_position":{"x":803.3096,"y":942.9739},"$type":"NodeCanvas.DialogueTrees.MultipleConditionNode","$id":"24"},{"statement":{"_text":"Would
    you ever break the law to save someone you love? Breaking the law seems like
    a tough time."},"_position":{"x":1214.0,"y":1603.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"25"},{"statement":{"_text":"The
    forest is pretty, but I can\u2019t shake the feeling that something\u2019s always
    watching."},"_UID":"99649e8c-7f9e-40eb-b184-6c005854631d","_position":{"x":1264.896,"y":1527.148},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"26"},{"statement":{"_text":"Mabye
    one day I''ll capture whatever or whoever it is on camera."},"_UID":"1abce8db-920b-48fd-8c62-f8e15c12fb96","_position":{"x":1468.18,"y":1521.588},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"27"},{"statement":{"_text":"I
    wonder where the stores get their food from. Magic? Mabye..."},"_UID":"1ecf06aa-7562-4958-a5ee-7e01f9040670","_position":{"x":1325.55,"y":1449.672},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"28"},{"statement":{"_text":"My
    cousin was an architect, really rich guy. He even designed this amazing expensive
    house. I could never live there though. My life is here."},"_UID":"215d887e-b30f-4f6a-afc4-5a244117f65d","_position":{"x":1353.149,"y":1369.053},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"29"},{"statement":{"_text":"I
    love relaxing outside, especially when the weather\u2019s nice. I need to just
    sit and watch the trees sway in the park."},"_UID":"8d509353-76bc-4162-a07a-5a2f838bcabe","_position":{"x":1388.079,"y":1281.879},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"30"},{"statement":{"_text":"
    I didn''t eat breakfast today... Silly me."},"_UID":"2d2522ca-f66f-4ee3-89c1-42d08e603518","_position":{"x":1433.906,"y":1201.706},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"31"},{"statement":{"_text":"I
    love taking pictures, but I wonder what it would be like to have an office job
    though."},"_UID":"ae914afa-e67b-4ef5-91ee-c214ec32a505","_position":{"x":1456.777,"y":1121.384},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"32"},{"statement":{"_text":"You
    ever see those films of teens walking into scary buildings? Quite freaky."},"_UID":"3e903f1b-17fe-4f42-b608-900d98d122a3","_position":{"x":1484.435,"y":1036.892},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"33"},{"statement":{"_text":"
    I grew up here, I really loved the sandwhiches my mother used to make. It always
    had the best bread."},"_UID":"f884a342-f62b-43e8-bf0d-17db5a5e38df","_position":{"x":1552.759,"y":953.7787},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"34"},{"statement":{"_text":"I''ve
    been itchin to back to school lately. I''ve never really been book-smart. But
    it wouldn''t hurt to start."},"_UID":"c52540c5-3978-4216-b0d1-d5138e2ef989","_position":{"x":1579.378,"y":865.1265},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"35"},{"statement":{"_text":"I
    think its kind of scary that the judge lett off that psycho. He was convicted
    and everything by our judge."},"_position":{"x":1637.0,"y":779.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"36"},{"statement":{"_text":"Too
    bad he killed him after he escapped..."},"_position":{"x":1836.0,"y":780.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"37"},{"statement":{"_text":"Oh
    Hey! "},"_position":{"x":849.0,"y":420.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"38"},{"statement":{"_text":"Thanks
    for leading me to the [theCorrectLocation] yesterday. I got some great photos."},"_position":{"x":804.0,"y":496.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"39"},{"statement":{"_text":"Heres
    a polaroid I snapped, mabye you can hang it up somewhere or put it to good use."},"_position":{"x":801.0,"y":576.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"40"},{"_action":{"actions":[{"boolVariable":{"_name":"completedTalkingTo","_targetVariableID":"47c0486a-cde4-4500-8a4f-dbba7f0bf60a"},"$type":"NodeCanvas.Tasks.Actions.SetBoolean"},{"method":{"_baseInfo":"Spawner|Spawn|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":800.0,"y":667.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"41"},{"statement":{"_text":"(Gained
