  _serializedExposedParameters: []
  _boundGraphSerialization: '{"type":"NodeCanvas.DialogueTrees.DialogueTree","nodes":[{"conditions":[null],"_UID":"3dbe52a7-48a7-40c7-b394-9c6573369dd0","_position":{"x":613.0597,"y":114.5243},"$type":"NodeCanvas.DialogueTrees.MultipleConditionNode","$id":"0"},{"_action":{"method":{"_baseInfo":"DialaugeChooser|SetDialaugeChoice|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"},"_UID":"30553741-2224-424e-a4bb-ebc994c5374c","_position":{"x":570.0354,"y":269.1845},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"1"},{"conditions":[null],"_UID":"f68020c6-79ff-43c0-87db-40128c2cf8f8","_position":{"x":619.3403,"y":435.1341},"$type":"NodeCanvas.DialogueTrees.MultipleConditionNode","$id":"2"},{"statement":{"_text":"Whatsup
    mister"},"_position":{"x":595.6702,"y":562.3342},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"3"},{"availableChoices":[{"statement":{"_text":"Whats
    been on your mind?"}},{"statement":{"_text":"I have some recomendations for places
    to take photos of."}}],"_position":{"x":544.4495,"y":676.5336},"$type":"NodeCanvas.DialogueTrees.MultipleChoiceNode","$id":"4"},{"childOptions":[{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}},{"weight":{"_value":1.0}}],"_position":{"x":283.2788,"y":900.5454},"$type":"NodeCanvas.DialogueTrees.ProbabilitySelector","$id":"5"},{"statement":{"_text":"I''ve
    been itchin to back to school lately. Being out here making a living is tough
    as is. But I would have to know more."},"_position":{"x":-113.8888,"y":1015.909},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"6"},{"statement":{"_text":"
    I grew up here, I really loved the sandwhiches my mother used to make. It always
    had the best bread."},"_position":{"x":-32.15073,"y":1115.441},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"7"},{"statement":{"_text":"You
    ever read those creepy stories of ghosts? I wouldn''t want one haunting me!"},"_position":{"x":112.0795,"y":1023.933},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"8"},{"statement":{"_text":"
    I didn''t eat breakfast today... Silly me."},"_position":{"x":207.0715,"y":1109.655},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"9"},{"statement":{"_text":"I
    love taking pictures, I wonder what it would be like to have an office job though."},"_position":{"x":357.0953,"y":1036.147},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"10"},{"statement":{"_text":"I
    wonder where the stores get their food from. Magic? Mabye..."},"_position":{"x":457.9604,"y":1124.147},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"11"},{"statement":{"_text":"My
    cousin was an architect, really rich guy. He even designed this amazing expensive
    house. I could never live there though. My life is here."},"_position":{"x":590.8889,"y":1042.489},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"12"},{"statement":{"_text":"Oh
    cool, where should I go to today?"},"_position":{"x":1021.075,"y":943.1001},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"13"},{"availableChoices":[{"statement":{"_text":"Sherriffs
